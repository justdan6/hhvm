#!/bin/sh
set -eu
hhvm_bundle_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
case "$(uname -m)" in
  x86_64) hhvm_loader_name=ld-linux-x86-64.so.2 ;;
  aarch64|arm64) hhvm_loader_name=ld-linux-aarch64.so.1 ;;
  *) echo "Unsupported Linux architecture" >&2; exit 1 ;;
esac
hhvm_loader="$hhvm_bundle_dir/lib/$hhvm_loader_name"
# HHVM inspects /proc/self/exe and its program break. It must be executed by
# the kernel, rather than passed as an argument to ld-linux. Keep the original
# binary intact and relocate a private copy once per extraction location.
if [ ! -x "$hhvm_bundle_dir/.hhvm-local" ] ||
   [ "$(cat "$hhvm_bundle_dir/.runtime-location" 2>/dev/null || true)" != "$hhvm_loader" ]; then
  hhvm_temporary=$(mktemp "$hhvm_bundle_dir/.hhvm-local.XXXXXX")
  trap 'rm -f "$hhvm_temporary"' 0 1 2 15
  cp "$hhvm_bundle_dir/hhvm" "$hhvm_temporary"
  "$hhvm_loader" --library-path "$hhvm_bundle_dir/lib" \
    "$hhvm_bundle_dir/tools/patchelf" --set-interpreter "$hhvm_loader" \
    --force-rpath --set-rpath '$ORIGIN/lib' "$hhvm_temporary"
  chmod 755 "$hhvm_temporary"
  mv -f "$hhvm_temporary" "$hhvm_bundle_dir/.hhvm-local"
  printf '%s\n' "$hhvm_loader" > "$hhvm_bundle_dir/.runtime-location"
  trap - 0 1 2 15
fi
export MAGICK_HOME="${MAGICK_HOME:-$hhvm_bundle_dir}"
export MAGICK_CONFIGURE_PATH="${MAGICK_CONFIGURE_PATH:-$hhvm_bundle_dir/etc/ImageMagick-6}"
exec "$hhvm_bundle_dir/.hhvm-local" "$@"
