+// Copyright (c) Meta Platforms, Inc. and affiliates.
+// Licensed under the PHP license in the root of this repository.
+#pragma once
+
+#include <array>
+#include <bit>
+#include <cstdint>
+#include <cstddef>
+
+namespace HPHP {
+
+// The degree-31, separation-3 additive generator used by random_r with a
+// 128-byte state. Keep request-local state on systems without that interface.
+struct BsdRandomState {
+  void seed(uint32_t value) {
+    if (!value) value = 1;
+    values[0] = value;
+    int64_t word = std::bit_cast<int32_t>(value);
+    for (std::size_t i = 1; i < values.size(); ++i) {
+      word = 16807 * (word % 127773) - 2836 * (word / 127773);
+      if (word < 0) word += 2147483647;
+      values[i] = static_cast<uint32_t>(word);
+    }
+    front = 3;
+    rear = 0;
+    for (std::size_t i = 0; i < values.size() * 10; ++i) next();
+  }
+
+  int32_t next() {
+    auto const value = values[front] + values[rear];
+    values[front] = value;
+    if (++front == values.size()) front = 0;
+    if (++rear == values.size()) rear = 0;
+    return static_cast<int32_t>(value >> 1);
+  }
+
+private:
+  std::array<uint32_t, 31> values{};
+  std::size_t front{3};
+  std::size_t rear{0};
+};
