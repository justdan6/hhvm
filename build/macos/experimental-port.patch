diff --git a/hphp/util/jit-code-lock.h b/hphp/util/jit-code-lock.h
new file mode 100644
index 000000000..520e306e5
--- /dev/null
+++ b/hphp/util/jit-code-lock.h
@@ -0,0 +1,50 @@
+#pragma once
+
+#include <mutex>
+#include <utility>
+#include "hphp/util/jit-write-protect.h"
+
+namespace HPHP {
+
+#if defined(__APPLE__) && defined(__aarch64__)
+template<class Mutex>
+struct JitCodeLock : std::unique_lock<Mutex> {
+  using Base = std::unique_lock<Mutex>;
+  JitCodeLock() = default;
+  explicit JitCodeLock(Mutex& mutex) : Base(mutex, std::defer_lock) { lock(); }
+  JitCodeLock(Mutex& mutex, std::defer_lock_t tag) : Base(mutex, tag) {}
+  JitCodeLock(JitCodeLock&& other) noexcept
+    : Base(std::move(other)), previous(other.previous) {}
+  JitCodeLock& operator=(JitCodeLock&& other) noexcept {
+    if (this == &other) return *this;
+    if (this->owns_lock()) jitSetExecutable(previous);
+    Base::operator=(std::move(other));
+    previous = other.previous;
+    return *this;
+  }
+  ~JitCodeLock() {
+    if (this->owns_lock()) jitSetExecutable(previous);
+  }
+  void lock() {
+    Base::lock();
+    beginWrite();
+  }
+  bool try_lock() {
+    if (!Base::try_lock()) return false;
+    beginWrite();
+    return true;
+  }
+  void unlock() {
+    jitSetExecutable(previous);
+    Base::unlock();
+  }
+private:
+  void beginWrite() {
+    previous = jitIsExecutable();
+    jitSetExecutable(false);
+  }
+  bool previous{true};
+};
+#endif
+
+}
diff --git a/hphp/util/jit-write-protect.h b/hphp/util/jit-write-protect.h
new file mode 100644
index 000000000..ae867a477
--- /dev/null
+++ b/hphp/util/jit-write-protect.h
@@ -0,0 +1,42 @@
+#pragma once
+
+#if defined(__APPLE__) && defined(__aarch64__)
+#include <pthread.h>
+#endif
+
+namespace HPHP {
+
+#if defined(__APPLE__) && defined(__aarch64__)
+// Darwin starts each thread with its MAP_JIT mappings executable. All HHVM
+// transitions go through this helper so nested scopes can restore the mode.
+inline thread_local bool s_jitExecutable = true;
+inline bool jitIsExecutable() { return s_jitExecutable; }
+inline void jitSetExecutable(bool executable) {
+  if (s_jitExecutable == executable) return;
+  pthread_jit_write_protect_np(executable ? 1 : 0);
+  s_jitExecutable = executable;
+}
+
+struct JitWriteScope {
+  JitWriteScope() : previous(jitIsExecutable()) { jitSetExecutable(false); }
+  ~JitWriteScope() { jitSetExecutable(previous); }
+  JitWriteScope(const JitWriteScope&) = delete;
+  JitWriteScope& operator=(const JitWriteScope&) = delete;
+private:
+  bool previous;
+};
+
+struct JitExecuteScope {
+  JitExecuteScope() : previous(jitIsExecutable()) { jitSetExecutable(true); }
+  ~JitExecuteScope() { jitSetExecutable(previous); }
+  JitExecuteScope(const JitExecuteScope&) = delete;
+  JitExecuteScope& operator=(const JitExecuteScope&) = delete;
+private:
+  bool previous;
+};
+#else
+struct JitWriteScope {};
+struct JitExecuteScope {};
+#endif
+
+}
