diff --git a/hphp/util/mmap.h b/hphp/util/mmap.h
new file mode 100644
index 000000000..b33f77eab
--- /dev/null
+++ b/hphp/util/mmap.h
@@ -0,0 +1,51 @@
+#pragma once
+
+#include <cerrno>
+#include <folly/portability/SysMman.h>
+#ifdef __APPLE__
+#include <mach/mach.h>
+#include <mach/mach_vm.h>
+#endif
+
+namespace HPHP {
+
+// Reserve an exact address without replacing any existing mapping. On systems
+// without MAP_FIXED_NOREPLACE, mmap's hint is non-destructive; discard a mapping
+// returned at another address. Also handles old Linux kernels ignoring the flag.
+inline void* mmap_fixed_noreplace(void* address, size_t length, int protection,
+                                  int flags, int fd, off_t offset) {
+#ifdef __APPLE__
+  // Darwin may relocate large anonymous mmap hints even when the range is
+  // free. VM_FLAGS_FIXED, without VM_FLAGS_OVERWRITE, reserves atomically and
+  // fails on overlap. Keep the generic path for files and special mappings.
+  if ((flags & MAP_ANONYMOUS) && (flags & MAP_PRIVATE) &&
+      !(flags & MAP_JIT) && fd == -1 && offset == 0) {
+    auto const task = mach_task_self();
+    mach_vm_address_t target = reinterpret_cast<uintptr_t>(address);
+    auto status = mach_vm_allocate(task, &target, length, VM_FLAGS_FIXED);
+    if (status != KERN_SUCCESS) {
+      errno = status == KERN_NO_SPACE ? EEXIST : ENOMEM;
+      return MAP_FAILED;
+    }
+    status = mach_vm_protect(task, target, length, false, protection);
+    if (status != KERN_SUCCESS) {
+      mach_vm_deallocate(task, target, length);
+      errno = EACCES;
+      return MAP_FAILED;
+    }
+    return reinterpret_cast<void*>(target);
+  }
+#endif
+#ifdef MAP_FIXED_NOREPLACE
+  flags |= MAP_FIXED_NOREPLACE;
+#endif
+  auto const result = mmap(address, length, protection, flags, fd, offset);
+  if (result != MAP_FAILED && result != address) {
+    munmap(result, length);
+    errno = EEXIST;
+    return MAP_FAILED;
+  }
+  return result;
+}
+
+}
